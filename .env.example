# ══════════════════════════════════════════════
# Variables d'environnement - Sites d'intervention
# ══════════════════════════════════════════════
# Copiez ce fichier en .env et modifiez les valeurs.
# Sur AlwysData, configurez ces variables dans le panneau d'administration.

# Mot de passe pour l'espace administration
ADMIN_PASSWORD=ADM12345

# Mot de passe pour accéder à la carte (client)
CLIENT_PASSWORD=CLI123456

# Secret pour les sessions (chaîne aléatoire recommandée)
SESSION_SECRET=12345

# Zone Lambert pour les coordonnées (LAMBERT_NORD, LAMBERT_CENTRE, LAMBERT_SUD, LAMBERT_SAHARA)
LAMBERT_ZONE=LAMBERT_NORD

# Port du serveur (sur AlwysData, utiliser le port assigné automatiquement)
PORT=3000
